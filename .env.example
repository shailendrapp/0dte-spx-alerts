# Copy this file to `.env` for local development.
# In GitHub Actions, set these as repository Secrets instead.

# ---- Tradier (production for real-time, sandbox for delayed) -----------------
TRADIER_TOKEN=your_tradier_token_here
TRADIER_BASE_URL=https://api.tradier.com

# ---- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ABCDEF...
TELEGRAM_CHAT_ID=123456789

# ---- Optional: GitHub PAT for state.json commits in local dev ---------------
# In GitHub Actions, the default GITHUB_TOKEN is granted contents:write so this
# is unnecessary in CI.  For local commits, set a personal access token here.
# GITHUB_TOKEN=ghp_xxx

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
